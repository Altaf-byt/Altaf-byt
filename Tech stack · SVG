<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 130" width="900" height="130" role="img" aria-label="Animated tech stack: Python, HTML5, CSS3, JavaScript, Git, GitHub, VS Code, Linux">
  <defs>
    <filter id="gl" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <style>
    .f { font-family: 'Fira Code', Consolas, 'Courier New', monospace; }
    .big { font-size: 28px; font-weight: bold; text-anchor: middle; }
    .lbl { font-size: 9px; letter-spacing: 1.5px; text-anchor: middle; fill: #9fb0d0; }
    .tile { fill: #05070d; stroke-width: 1.8; animation: pulse 3s ease-in-out infinite; }
    @keyframes pulse { 0%, 100% { stroke-opacity: 0.45; } 50% { stroke-opacity: 1; } }
  </style>

  <g class="f">
    <g transform="translate(19 16)">
      <animateTransform attributeName="transform" type="translate" values="19 16;19 8;19 16" dur="3s" begin="0s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#00b0ff"/>
      <text class="big" x="46" y="52" fill="#00b0ff" filter="url(#gl)">Py</text>
      <text class="lbl" x="46" y="78">PYTHON</text>
    </g>
    <g transform="translate(129 16)">
      <animateTransform attributeName="transform" type="translate" values="129 16;129 8;129 16" dur="3s" begin="-0.35s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#b388ff" style="animation-delay:0.35s"/>
      <text class="big" x="46" y="52" fill="#b388ff" filter="url(#gl)">&lt;/&gt;</text>
      <text class="lbl" x="46" y="78">HTML5</text>
    </g>
    <g transform="translate(239 16)">
      <animateTransform attributeName="transform" type="translate" values="239 16;239 8;239 16" dur="3s" begin="-0.7s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#00e676" style="animation-delay:0.7s"/>
      <text class="big" x="46" y="52" fill="#00e676" filter="url(#gl)">{;}</text>
      <text class="lbl" x="46" y="78">CSS3</text>
    </g>
    <g transform="translate(349 16)">
      <animateTransform attributeName="transform" type="translate" values="349 16;349 8;349 16" dur="3s" begin="-1.05s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#00b0ff" style="animation-delay:1.05s"/>
      <text class="big" x="46" y="52" fill="#00b0ff" filter="url(#gl)">JS</text>
      <text class="lbl" x="46" y="78">JAVASCRIPT</text>
    </g>
    <g transform="translate(459 16)">
      <animateTransform attributeName="transform" type="translate" values="459 16;459 8;459 16" dur="3s" begin="-1.4s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#b388ff" style="animation-delay:1.4s"/>
      <text class="big" x="46" y="52" fill="#b388ff" filter="url(#gl)">git</text>
      <text class="lbl" x="46" y="78">GIT</text>
    </g>
    <g transform="translate(569 16)">
      <animateTransform attributeName="transform" type="translate" values="569 16;569 8;569 16" dur="3s" begin="-1.75s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#00e676" style="animation-delay:1.75s"/>
      <text class="big" x="46" y="52" fill="#00e676" filter="url(#gl)">GH</text>
      <text class="lbl" x="46" y="78">GITHUB</text>
    </g>
    <g transform="translate(679 16)">
      <animateTransform attributeName="transform" type="translate" values="679 16;679 8;679 16" dur="3s" begin="-2.1s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#00b0ff" style="animation-delay:2.1s"/>
      <text class="big" x="46" y="52" fill="#00b0ff" filter="url(#gl)">VS</text>
      <text class="lbl" x="46" y="78">VS CODE</text>
    </g>
    <g transform="translate(789 16)">
      <animateTransform attributeName="transform" type="translate" values="789 16;789 8;789 16" dur="3s" begin="-2.45s" repeatCount="indefinite"/>
      <rect class="tile" width="92" height="92" rx="16" stroke="#b388ff" style="animation-delay:2.45s"/>
      <text class="big" x="46" y="52" fill="#b388ff" filter="url(#gl)">$_</text>
      <text class="lbl" x="46" y="78">LINUX</text>
    </g>
  </g>
</svg>
